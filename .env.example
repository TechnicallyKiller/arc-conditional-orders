# ── Keeper ────────────────────────────────────────────────────────────────
RPC_URL=https://rpc.testnet.arc.io
ORDER_BOOK=0x80C8B0b55827F0456564554E3A82F9B20ad6019F
SWAP_ADAPTER=0x80FBe4f593fc33A102CC41e3aF158ED4Fb71864C
POLL_MS=3000
# Only for execute mode. Never commit a real key.
KEEPER_PRIVATE_KEY=

# ── Frontend: Circle Modular Wallets (passkey + sponsored gas) ─────────────
# Console → Keys → Client Keys. Shown once, starts with TEST_API_KEY:
# Also configure the Passkey Domain in Console — passkeys are domain-bound.
# Without this the app still works; the passkey option is hidden and users
# connect an injected wallet instead.
NEXT_PUBLIC_CLIENT_KEY=
NEXT_PUBLIC_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
