# Copy to .env and fill in. .env is gitignored; this file is NOT - never put a real
# secret here, not even briefly. Anything committed here must be treated as public
# and rotated, because removing it in a later commit does not remove it from history.

# ── Network ───────────────────────────────────────────────────────────────
# Testnet while developing. Mainnet is https://rpc.mainnet.arc.io (chain 5042).
RPC_URL=https://rpc.testnet.arc.io

# ── Deployed contracts ────────────────────────────────────────────────────
# Filled in by script/Deploy.s.sol (testnet) or script/DeployMainnet.s.sol.
ORDER_BOOK=
SWAP_ADAPTER=
POLL_MS=3000

# ── Keys ──────────────────────────────────────────────────────────────────
# Deployer. Only needed at deploy time; unset it afterwards.
PRIVATE_KEY=
# Keeper. Only used in execute mode. Needs a small USDC balance for gas.
KEEPER_PRIVATE_KEY=
# Where protocol fees are sent. Defaults to the deployer if unset.
FEE_RECIPIENT=

# ── Exposure caps (MAINNET ONLY - DeployMainnet refuses to run without them) ──
# USDC, 6dp. These bind on REALISED PROCEEDS of a fill, not on the input amount:
# the output leg is USDC, so the cap is exact with no price oracle involved.
# 0 means unlimited, which is why the mainnet script rejects 0 rather than
# defaulting to it. Changeable later by the owner via setCaps().
#   25000000  =    25 USDC per fill
#  250000000  =   250 USDC cumulative
MAX_ORDER_USDC=25000000
MAX_TOTAL_USDC=250000000

# ── Frontend RPC (optional) ───────────────────────────────────────────────
# The public Arc RPC returns HTTP 429 under load. Point these at a provider
# endpoint (Alchemy et al.) to avoid it.
#
# WARNING: NEXT_PUBLIC_* values are inlined into the browser bundle at build
# time. An endpoint with an embedded API key IS PUBLIC. Restrict it by
# referrer/domain in the provider dashboard - do not rely on it being secret.
NEXT_PUBLIC_ARC_MAINNET_RPC=
NEXT_PUBLIC_ARC_TESTNET_RPC=

# Optional: surface the keeper process's own health endpoint on /status.
NEXT_PUBLIC_KEEPER_HEALTH_URL=

# ── Frontend wallet (Privy) ───────────────────────────────────────────────
# App ID only. It is public by design and safe to expose in the client bundle.
# The Privy APP SECRET is a server credential: it must never be prefixed
# NEXT_PUBLIC_ (Next.js inlines those into the browser bundle) and must never
# appear in this file.
NEXT_PUBLIC_PRIVY_APP_ID=
